# LinguaSI API settings. Copy to backend/.env (or the repository's root .env) and adjust.
# Real environment variables override both files. Every setting has a working default for local
# development, so an empty .env runs the API in Mock AI Mode against a local PostgreSQL.
# Never commit a .env file, and never put these values into the web or mobile app.

# --- Application -------------------------------------------------------------------------------
# development | test | production. Production refuses to start with the default JWT secret.
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# --- Database (PostgreSQL) ---------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://linguasi:linguasi@localhost:5432/linguasi
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# --- Auth --------------------------------------------------------------------------------------
# A long random value in production, e.g. the output of: openssl rand -hex 32
JWT_SECRET=dev-insecure-secret-change-me-0123456789abcdef
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30
# Accounts with these emails become admins when they register (comma-separated).
# Existing accounts: python -m app.cli create-admin you@example.com
ADMIN_EMAILS=

# --- HTTP --------------------------------------------------------------------------------------
# Browser origins allowed to call the API directly. The web app calls it server-side (no CORS
# needed); this list matters for the Expo web preview and any other browser client.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081,http://localhost:19006
RATE_LIMIT_ENABLED=true
# Shared rate-limit counters. Needed once more than one API instance runs.
REDIS_URL=
# Read by the Docker image's start command, not by the app: the proxy / web server addresses
# whose X-Forwarded-For header is trusted (comma-separated IPs or CIDRs). Avoid "*": Uvicorn then
# takes the left-most entry, which the client can set.
# FORWARDED_ALLOW_IPS=127.0.0.1
# For a web server without fixed addresses (e.g. Vercel): the same random value here and in the web
# app's environment lets the API trust the learner address the web server reports. 32+ characters.
PROXY_SHARED_SECRET=

# --- AI (SI Core) ------------------------------------------------------------------------------
# mock | anthropic | openai | gemini. Mock AI Mode is used whenever AI_MOCK_MODE=true, the
# provider is "mock", or the selected provider has no API key. Keys stay on the server.
AI_PROVIDER=mock
AI_MOCK_MODE=true
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Model names per tier; empty = the provider's defaults (see app/core/config.py).
# "fast" handles short, frequent tasks; "strong" handles evaluations and planning.
AI_MODEL_FAST=
AI_MODEL_STRONG=
# Reasoning effort per tier (providers that support it): low | medium | high (| xhigh | max for strong).
AI_EFFORT_FAST=low
AI_EFFORT_STRONG=medium
AI_TIMEOUT_SECONDS=90
AI_MAX_RETRIES=2
# How many times an invalid structured response is sent back to the model for repair.
AI_REPAIR_ATTEMPTS=1
# Anthropic only: when a model declines a request (a refusal), the API re-runs it on Anthropic's
# recommended fallback model server-side (beta "fallbacks": "default"). Never sent for Haiku models.
ANTHROPIC_SERVER_FALLBACK=true
# Store prompts and responses in the AI request log (off by default: they contain learner writing).
AI_LOG_CONTENT=false
# AI requests per learner per hour.
AI_USER_HOURLY_LIMIT=80

# --- Speech ------------------------------------------------------------------------------------
# mock | openai. "openai" needs OPENAI_API_KEY. Without speech-to-text, learners type or dictate
# their spoken answers and pronunciation is not scored; without text-to-speech, the device's own
# voices read listening scripts and examiner questions.
STT_PROVIDER=mock
TTS_PROVIDER=mock
OPENAI_STT_MODEL=whisper-1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
MAX_AUDIO_UPLOAD_MB=15

# --- File storage (speaking recordings) ---------------------------------------------------------
# local | s3. Use s3 (or any S3-compatible service) when the API's disk is not persistent.
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Content -----------------------------------------------------------------------------------
# Curated seed content (vocabulary, tasks, passages...). Defaults to <repo>/database/seed.
SEED_DIR=
# Load the seed content on startup when the content tables are empty.
AUTO_SEED=true
