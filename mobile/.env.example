# Address of the LinguaSI API (FastAPI backend). Public by design: it is compiled into the app.
# Never put AI provider keys or other secrets in EXPO_PUBLIC_* variables - they live only on the server.
#
# Leave unset in development: the app uses port 8000 on the machine running Metro, which works
# from simulators and from a phone on the same Wi-Fi network.
# EXPO_PUBLIC_API_URL=http://192.168.1.20:8000
# EXPO_PUBLIC_API_URL=https://api.your-domain.com
