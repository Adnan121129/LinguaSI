# Settings for `docker compose up`. Copy to .env (never commit it) and set JWT_SECRET.
# When you run the API without Docker it reads this file too; backend/.env.example lists every
# API setting, and any of them can be added here.

# Required: a long random secret that signs sessions, e.g. the output of: openssl rand -hex 32
JWT_SECRET=

# Password for the bundled PostgreSQL container.
POSTGRES_PASSWORD=linguasi

# AI. As written, LinguaSI runs in Mock AI Mode: no keys, no cost, deterministic feedback.
# For real AI feedback set AI_MOCK_MODE=false, choose AI_PROVIDER and add that provider's key.
# Keys stay on the server; they are never sent to the web or mobile apps.
AI_PROVIDER=mock
AI_MOCK_MODE=true
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Speech-to-text and text-to-speech: mock | openai (needs OPENAI_API_KEY).
STT_PROVIDER=mock
TTS_PROVIDER=mock

# Accounts with these emails become admins when they register (comma-separated).
ADMIN_EMAILS=

# Session cookies are HTTPS-only unless this is false. Keep false for http://localhost;
# set it to true when the web app is served over HTTPS.
COOKIE_SECURE=false
