# Optional settings for LinguaSI with Docker (start-windows.bat, start.sh or `docker compose up`).
# LinguaSI runs without this file. To change something, copy it to a file named .env in the same
# folder (never commit .env), fill in what you need and start LinguaSI again.
# backend/.env.example lists every API setting; any of them can be added here as well.

# Ports on your computer. Change one if another program already uses it.
WEB_PORT=3000
API_PORT=8000
MOBILE_PORT=8081

# The secret that signs sign-in sessions. Leave it empty: on its first start the API creates a
# random one and keeps it in a Docker volume. To manage it yourself, set a long random value
# (e.g. the output of: openssl rand -hex 32).
JWT_SECRET=

# Password of the bundled PostgreSQL database. Only takes effect before the first start: the
# database keeps the password it was created with.
POSTGRES_PASSWORD=linguasi

# AI. As written, LinguaSI runs in Mock AI Mode: no keys, no cost, deterministic feedback.
# For real AI feedback set AI_MOCK_MODE=false, choose AI_PROVIDER and add that provider's key.
# Keys stay on the server; they are never sent to the web or mobile apps. The provider bills API
# usage separately: a chat subscription does not include API credits.
AI_PROVIDER=mock
AI_MOCK_MODE=true
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Speech-to-text and text-to-speech: mock | openai (needs OPENAI_API_KEY).
STT_PROVIDER=mock
TTS_PROVIDER=mock

# Accounts with these emails become admins when they register (comma-separated).
ADMIN_EMAILS=

# Session cookies are HTTPS-only unless this is false. Keep false for http://localhost;
# set it to true when the web app is served over HTTPS.
COOKIE_SECURE=false

# Only for a shared server behind a reverse proxy: the same random value (32+ characters) is given
# to the API and the web server, so the API can rate-limit each learner's own address.
PROXY_SHARED_SECRET=
