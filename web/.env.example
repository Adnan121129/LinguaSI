# URL of the LinguaSI FastAPI backend (server-side only; never exposed to the browser).
BACKEND_URL=http://localhost:8000
# Send session cookies only over HTTPS. Defaults to true in production builds.
# COOKIE_SECURE=true
# Optional. The same random value as the API's PROXY_SHARED_SECRET, so per-IP limits (sign-in,
# registration) count each learner separately even though this server's own address changes.
# PROXY_SHARED_SECRET=
